{
  "name": "RecurringCharge",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "ID de la cotizaci\u00f3n asociada (opcional)"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "client_company": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Nombre del servicio"
    },
    "amount": {
      "type": "number",
      "description": "Monto mensual"
    },
    "billing_day": {
      "type": "number",
      "description": "D\u00eda del mes para cobrar (1-28)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Inicio de la vigencia del servicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fin de la vigencia del servicio"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si el servicio est\u00e1 activo"
    }
  },
  "required": [
    "client_name",
    "amount",
    "billing_day"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}