{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de emisi\u00f3n"
    },
    "amount": {
      "type": "number",
      "description": "Monto de la factura en CLP"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "files": {
      "type": "array",
      "description": "Archivos adjuntos",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "invoice_number",
    "issue_date"
  ]
}