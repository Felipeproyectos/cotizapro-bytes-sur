{
  "name": "OperationalExpense",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del gasto"
    },
    "category": {
      "type": "string",
      "enum": [
        "Materiales",
        "Herramientas",
        "Transporte",
        "Arriendo",
        "Servicios",
        "Sueldos",
        "Software",
        "Otros"
      ],
      "description": "Categor\u00eda del gasto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del gasto"
    },
    "amount": {
      "type": "number",
      "description": "Monto en CLP"
    },
    "supplier": {
      "type": "string",
      "description": "Proveedor o destino del gasto"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Si es un gasto mensual recurrente"
    },
    "recurrence_day": {
      "type": "number",
      "description": "D\u00eda del mes en que se cobra (1-28)"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "description": "Si ya fue pagado"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se marc\u00f3 como pagado"
    },
    "quote_id": {
      "type": "string",
      "description": "ID de la cotizaci\u00f3n asociada (si viene de una cotizaci\u00f3n)"
    },
    "quote_number": {
      "type": "string",
      "description": "N\u00famero de cotizaci\u00f3n asociada"
    },
    "quote_client": {
      "type": "string",
      "description": "Nombre del cliente de la cotizaci\u00f3n"
    }
  },
  "required": [
    "date",
    "description",
    "amount"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}