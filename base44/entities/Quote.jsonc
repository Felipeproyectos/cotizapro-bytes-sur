{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "Número de cotización"
    },
    "title": {
      "type": "string",
      "description": "Título o asunto de la cotización"
    },
    "currency": {
      "type": "string",
      "enum": [
        "CLP",
        "UF"
      ],
      "default": "CLP",
      "description": "Moneda de la cotización"
    },
    "uf_value": {
      "type": "number",
      "description": "Valor de la UF en pesos CLP al momento de la cotización"
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "Único",
        "Mensual"
      ],
      "default": "Único",
      "description": "Tipo de cobro"
    },
    "billing_day": {
      "type": "number",
      "description": "Día del mes para cobro mensual (1-28)"
    },
    "client_name": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "client_rut": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_type_id": {
            "type": "string"
          },
          "service_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "unit_price_uf": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "total_uf": {
            "type": "number"
          },
          "is_operational_expense": {
            "type": "boolean",
            "default": false,
            "description": "Indica si este ítem es un gasto operacional interno (no cuenta como ganancia)"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "subtotal_uf": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "description": "Descuento en pesos CLP",
      "default": 0
    },
    "discount_percent": {
      "type": "number",
      "description": "Porcentaje de descuento calculado"
    },
    "subtotal_after_discount": {
      "type": "number",
      "description": "Subtotal después del descuento"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "Sin IVA",
        "Con IVA (19%)",
        "Boleta de Honorarios"
      ],
      "default": "Sin IVA"
    },
    "include_iva": {
      "type": "boolean",
      "default": false
    },
    "iva_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "total_uf": {
      "type": "number"
    },
    "total_operational_expenses": {
      "type": "number",
      "description": "Suma total de los gastos operacionales de esta cotización",
      "default": 0
    },
    "net_profit": {
      "type": "number",
      "description": "Ganancia neta = total cobrado al cliente - gastos operacionales"
    },
    "payment_options": {
      "type": "array",
      "description": "Opciones de datos de pago seleccionadas para esta cotización",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "titular": {
            "type": "string"
          },
          "rut": {
            "type": "string"
          },
          "banco": {
            "type": "string"
          },
          "tipo_cuenta": {
            "type": "string"
          },
          "numero_cuenta": {
            "type": "string"
          },
          "email_confirmacion": {
            "type": "string"
          }
        }
      }
    },
    "abonos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "monto": {
            "type": "number"
          },
          "nota": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "Enviada",
        "Aceptada",
        "Rechazada",
        "Ejecutada"
      ],
      "default": "Borrador"
    },
    "notes": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "executed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "client_name",
    "items"
  ]
}
