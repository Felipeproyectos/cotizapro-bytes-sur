{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "N\u00famero de cotizaci\u00f3n"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo o asunto de la cotizaci\u00f3n"
    },
    "currency": {
      "type": "string",
      "enum": [
        "CLP",
        "UF"
      ],
      "default": "CLP",
      "description": "Moneda de la cotizaci\u00f3n"
    },
    "uf_value": {
      "type": "number",
      "description": "Valor de la UF en pesos CLP al momento de la cotizaci\u00f3n"
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "\u00danico",
        "Mensual"
      ],
      "default": "\u00danico",
      "description": "Tipo de cobro"
    },
    "billing_day": {
      "type": "number",
      "description": "D\u00eda del mes para cobro mensual (1-28)"
    },
    "client_name": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "client_rut": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_type_id": {
            "type": "string"
          },
          "service_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "unit_price_uf": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "total_uf": {
            "type": "number"
          },
          "is_operational_expense": {
            "type": "boolean"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "subtotal_uf": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "description": "Descuento en pesos CLP",
      "default": 0
    },
    "discount_percent": {
      "type": "number",
      "description": "Porcentaje de descuento calculado"
    },
    "subtotal_after_discount": {
      "type": "number",
      "description": "Subtotal despu\u00e9s del descuento"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "Sin IVA",
        "Con IVA (19%)",
        "Boleta de Honorarios"
      ],
      "default": "Sin IVA"
    },
    "include_iva": {
      "type": "boolean",
      "default": false
    },
    "iva_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "total_uf": {
      "type": "number"
    },
    "payment_options": {
      "type": "array",
      "description": "Opciones de datos de pago seleccionadas para esta cotizaci\u00f3n",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "titular": {
            "type": "string"
          },
          "rut": {
            "type": "string"
          },
          "banco": {
            "type": "string"
          },
          "tipo_cuenta": {
            "type": "string"
          },
          "numero_cuenta": {
            "type": "string"
          },
          "email_confirmacion": {
            "type": "string"
          }
        }
      }
    },
    "abonos": {
      "type": "array",
      "description": "Pagos o abonos registrados sobre la cotizaci\u00f3n",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador del abono (para anulaciones e idempotencia)"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "monto": {
            "type": "number"
          },
          "nota": {
            "type": "string"
          },
          "medio_pago": {
            "type": "string",
            "description": "Efectivo, Transferencia, Tarjeta, Cheque u Otro"
          },
          "referencia": {
            "type": "string",
            "description": "N\u00famero de referencia o comprobante"
          },
          "registrado_por": {
            "type": "string"
          },
          "registrado_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "description": "Clave de idempotencia para evitar duplicados"
          },
          "anulado": {
            "type": "boolean",
            "default": false
          },
          "anulado_por": {
            "type": "string"
          },
          "anulado_at": {
            "type": "string",
            "format": "date-time"
          },
          "anulado_motivo": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Borrador",
        "Enviada",
        "Aceptada",
        "Rechazada",
        "Ejecutada"
      ],
      "default": "Borrador"
    },
    "work_status": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En ejecuci\u00f3n",
        "Por entregar",
        "Ejecutado",
        "Cancelado"
      ],
      "enumColors": [
        "gray",
        "blue",
        "orange",
        "green",
        "red"
      ],
      "description": "Estado del trabajo, independiente del estado de pago"
    },
    "payment_due_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento del pago del saldo pendiente"
    },
    "next_followup_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del pr\u00f3ximo seguimiento de cobranza"
    },
    "collection_log": {
      "type": "array",
      "description": "Historial cronol\u00f3gico de gestiones de cobranza (notas, pagos, anulaciones y cambios de estado)",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "nota",
              "pago",
              "anulacion",
              "estado",
              "vencimiento",
              "seguimiento"
            ]
          },
          "text": {
            "type": "string"
          },
          "user": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "executed_date": {
      "type": "string",
      "format": "date"
    },
    "total_operational_expenses": {
      "type": "number",
      "description": "Total de materiales y repuestos (gastos operacionales)"
    },
    "total_client": {
      "type": "number",
      "description": "Total a pagar por el cliente (servicios + materiales)"
    }
  },
  "required": [
    "client_name",
    "items"
  ]
}